# Serves the page and a read-only slice of the Prometheus HTTP API (instant + range queries, GET only).
# PROMETHEUS_URL is filled in by the image's envsubst step at startup.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    location ~ ^/api/v1/(query|query_range)$ {
        limit_except GET { deny all; }
        proxy_pass ${PROMETHEUS_URL};
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_read_timeout 15s;
    }
}
