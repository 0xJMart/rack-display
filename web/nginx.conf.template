# Serves the page and read-only slices of the Prometheus API (instant + range queries) and the
# Alertmanager API (alert list, for silences). GET only.
# PROMETHEUS_URL / ALERTMANAGER_URL are filled in by the image's envsubst step at startup.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    location ~ ^/api/v1/(query|query_range)$ {
        limit_except GET { deny all; }
        proxy_pass ${PROMETHEUS_URL};
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_read_timeout 15s;
    }

    location = /alertmanager/api/v2/alerts {
        limit_except GET { deny all; }
        proxy_pass ${ALERTMANAGER_URL}/api/v2/alerts;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_read_timeout 15s;
    }
}
